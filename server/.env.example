# Copy this file to .env for local use, or set these in Render's dashboard.
# Never commit a real .env - it holds your database password.

# Neon connection string (Neon dashboard -> Connect). Required.
DATABASE_URL=

# Sites allowed to call the API, comma-separated.
ALLOWED_ORIGINS=https://hafsa2n.github.io,http://localhost:5173

# Render sets this for you. Only needed locally.
PORT=3000
